#!/usr/bin/env bash
__git_prompt (){
  local branch='' staged_count='' modified_count='' record original_path
  local index_status worktree_status
  while IFS= read -r -d '' record; do
    case "$record" in
      '# branch.head '*)
        branch=${record#\# branch.head }
        [[ "$branch" == '(detached)' ]] && branch=''
        staged_count=0
        modified_count=0
        ;;
      '1 '*|'2 '*)
        index_status=${record:2:1}
        worktree_status=${record:3:1}
        [[ "$index_status" != '.' ]] && ((staged_count+=1))
        [[ "$worktree_status" != '.' ]] && ((modified_count+=1))
        # A rename or copy has a second path record.
        [[ "$record" == '2 '* ]] && IFS= read -r -d '' original_path
        ;;
      'u '*)
        ((staged_count+=1))
        ((modified_count+=1))
        ;;
    esac
  done < <(GIT_OPTIONAL_LOCKS=0 git status --porcelain=v2 --branch --untracked-files=no -z 2>/dev/null)

  # Readline uses these markers to exclude colors from the prompt width.
  printf '\001%b\002%s\001%b\002:\001%b\002%s\001%b\002,\001%b\002%s' \
    "$repo" "$branch" "$divs" "$staged" "$staged_count" \
    "$divs" "$modified" "$modified_count"
}

__conda_env (){
  CONDA_INFO=''
  if [[ $SHOW_CONDA_ENV == 1 && -n $CONDA_DEFAULT_ENV ]]; then
    CONDA_INFO+="($CONDA_DEFAULT_ENV)"
  fi
  echo $CONDA_INFO
}

empty(){
  vim -u NONE
}

